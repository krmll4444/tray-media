<Window x:Class="TrayMedia.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tray Media"
        Width="320"
        Height="146"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Focusable="True"
        ShowActivated="True"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        KeyDown="OnKeyDown">
  <Border x:Name="Flyout"
          Background="#D21F1F1F"
          BorderBrush="#29FFFFFF"
          BorderThickness="1"
          Padding="12,10,12,8"
          SnapsToDevicePixels="True">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="48"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="48"/>
          <ColumnDefinition Width="10"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="AlbumArtHost"
                Width="48"
                Height="48"
                CornerRadius="2"
                ClipToBounds="True"
                Background="#667F7F7F">
          <Image x:Name="AlbumArt"
                 Stretch="UniformToFill"
                 Visibility="Collapsed"/>
        </Border>

        <StackPanel Grid.Column="2" VerticalAlignment="Center">
          <TextBlock x:Name="TitleText"
                     FontFamily="Segoe UI"
                     FontSize="13"
                     FontWeight="SemiBold"
                     Foreground="White"
                     TextTrimming="CharacterEllipsis"
                     TextWrapping="NoWrap"
                     Text="Track Name"/>
          <TextBlock x:Name="ArtistText"
                     Margin="0,2,0,0"
                     FontFamily="Segoe UI"
                     FontSize="12"
                     Foreground="#FFC8C8C8"
                     TextTrimming="CharacterEllipsis"
                     TextWrapping="NoWrap"
                     Text="Artist Name"/>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1" Margin="0,8,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="12"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid x:Name="ProgressBar"
              Background="Transparent"
              Cursor="Hand"
              MouseLeftButtonDown="OnProgressDown"
              MouseMove="OnProgressMove"
              MouseLeftButtonUp="OnProgressUp"
              MouseLeave="OnProgressLeave">
          <Rectangle x:Name="ProgressTrack"
                     Height="2"
                     VerticalAlignment="Center"
                     Fill="#38FFFFFF"/>
          <Rectangle x:Name="ProgressFill"
                     Height="2"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Center"
                     Width="0"
                     Fill="#FF0078D4"/>
          <Ellipse x:Name="ProgressThumb"
                   Width="10"
                   Height="10"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   Margin="-5,0,0,0"
                   Fill="#FF0078D4"
                   Opacity="0">
            <Ellipse.RenderTransform>
              <ScaleTransform ScaleX="0" ScaleY="0"/>
            </Ellipse.RenderTransform>
          </Ellipse>
        </Grid>

        <Grid Grid.Row="1" Margin="0,2,0,0">
          <TextBlock x:Name="ElapsedText"
                     HorizontalAlignment="Left"
                     FontFamily="Segoe UI"
                     FontSize="11"
                     Foreground="#FFC8C8C8"
                     Text="0:00"/>
          <TextBlock x:Name="DurationText"
                     HorizontalAlignment="Right"
                     FontFamily="Segoe UI"
                     FontSize="11"
                     Foreground="#FFC8C8C8"
                     Text="0:00"/>
        </Grid>
      </Grid>

      <StackPanel Grid.Row="2"
                  Orientation="Horizontal"
                  HorizontalAlignment="Center"
                  Margin="0,4,0,0">
        <Button x:Name="PrevBtn"
                Style="{StaticResource CtrlButton}"
                Click="OnPrevClick"
                ToolTip="Previous track">
          <Path x:Name="PrevIcon"
                Width="16" Height="16"
                Stretch="Uniform"
                Fill="White"
                Data="M6,6 H8 V18 H6 Z M9.5,12 L18,18 V6 Z"/>
        </Button>
        <Button x:Name="PlayBtn"
                Style="{StaticResource CtrlButton}"
                Click="OnPlayClick"
                ToolTip="Play">
          <Grid Width="18" Height="18">
            <Path x:Name="PlayIcon"
                  Width="18" Height="18"
                  Stretch="Uniform"
                  Fill="White"
                  Data="M8,5 V19 L19,12 Z"/>
            <Path x:Name="PauseIcon"
                  Width="18" Height="18"
                  Stretch="Uniform"
                  Fill="White"
                  Visibility="Collapsed"
                  Data="M7,5 H10.4 V19 H7 Z M13.6,5 H17 V19 H13.6 Z"/>
          </Grid>
        </Button>
        <Button x:Name="NextBtn"
                Style="{StaticResource CtrlButton}"
                Click="OnNextClick"
                ToolTip="Next track">
          <Path x:Name="NextIcon"
                Width="16" Height="16"
                Stretch="Uniform"
                Fill="White"
                Data="M16,6 H18 V18 H16 Z M6,18 L14.5,12 L6,6 Z"/>
        </Button>
      </StackPanel>
    </Grid>
  </Border>
</Window>
