<Window x:Class="TrayMedia.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tray Media — Settings"
        Width="360"
        Height="220"
        MinWidth="320"
        MinHeight="200"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1F1F1F"
        FontFamily="Segoe UI">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Text="Settings"
               FontSize="18"
               FontWeight="SemiBold"
               Foreground="White"/>

    <StackPanel Grid.Row="1" Margin="0,18,0,0">
      <CheckBox x:Name="AutostartCheck"
                Content="Автозапуск з Windows"
                Foreground="White"
                Margin="0,0,0,12"/>
      <CheckBox x:Name="PinToTrayCheck"
                Content="Закріпити іконку в треї (не в Hidden icons)"
                Foreground="White"/>
      <TextBlock Margin="0,10,0,0"
                 FontSize="11"
                 Foreground="#A0A0A0"
                 TextWrapping="Wrap"
                 Text="Якщо Windows все одно ховає іконку — перевірте «Select which icons appear on the taskbar»."/>
    </StackPanel>

    <StackPanel Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right">
      <Button Content="Скасувати"
              Width="96"
              Height="30"
              Margin="0,0,8,0"
              Click="OnCancel"/>
      <Button Content="Зберегти"
              Width="96"
              Height="30"
              IsDefault="True"
              Click="OnSave"/>
    </StackPanel>
  </Grid>
</Window>
