<Window x:Class="TrayMedia.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tray Media"
        Width="560"
        Height="440"
        MinWidth="440"
        MinHeight="360"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        FontFamily="Segoe UI"
        Background="#FFFFFFFF"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
  <Window.Resources>
    <SolidColorBrush x:Key="SettingsAccentBrush" Color="#FF0078D4"/>
    <SolidColorBrush x:Key="ToggleOffBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="ToggleOffBorderBrush" Color="#FF888888"/>
    <SolidColorBrush x:Key="ToggleThumbOffBrush" Color="#FF333333"/>

    <Style x:Key="WinToggle" TargetType="ToggleButton">
      <Setter Property="Width" Value="44"/>
      <Setter Property="Height" Value="20"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Grid>
              <Border x:Name="Track"
                      CornerRadius="10"
                      Background="{DynamicResource ToggleOffBrush}"
                      BorderBrush="{DynamicResource ToggleOffBorderBrush}"
                      BorderThickness="1.5"
                      SnapsToDevicePixels="True"/>
              <Ellipse x:Name="Thumb"
                       Width="12" Height="12"
                       Fill="{DynamicResource ToggleThumbOffBrush}"
                       HorizontalAlignment="Left"
                       Margin="4,0,0,0"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{DynamicResource SettingsAccentBrush}"/>
                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource SettingsAccentBrush}"/>
                <Setter TargetName="Thumb" Property="Fill" Value="White"/>
                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="Thumb" Property="Margin" Value="0,0,4,0"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Track" Property="Opacity" Value="0.92"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid x:Name="Root" Background="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Background}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <StackPanel Margin="36,28,36,4">
      <TextBlock x:Name="PageTitle"
                 Text="Tray Media"
                 FontSize="28"
                 FontWeight="SemiBold"
                 Foreground="#FF1A1A1A"/>
    </StackPanel>

    <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto"
                  Padding="36,16,36,28">
      <StackPanel MaxWidth="680" HorizontalAlignment="Left">
        <TextBlock x:Name="SectionLabel"
                   Text="Startup &amp; tray"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="#FF1A1A1A"
                   Margin="0,0,0,18"/>

        <!-- Flat row: no card / border block -->
        <Grid x:Name="AutostartRow" Margin="0,0,0,22">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
            <TextBlock x:Name="AutostartTitle"
                       Text="Launch at startup"
                       FontSize="15"
                       Foreground="#FF1A1A1A"/>
            <TextBlock x:Name="AutostartDesc"
                       Margin="0,4,0,0"
                       Text="Open Tray Media automatically when you sign in to Windows."
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="#FF5D5D5D"/>
          </StackPanel>
          <ToggleButton x:Name="AutostartToggle"
                        Grid.Column="1"
                        Style="{StaticResource WinToggle}"
                        VerticalAlignment="Center"
                        Checked="OnAutostartChanged"
                        Unchecked="OnAutostartChanged"/>
        </Grid>

        <Grid x:Name="PinRow" Margin="0,0,0,22">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
            <TextBlock x:Name="PinTitle"
                       Text="Show icon on the taskbar"
                       FontSize="15"
                       Foreground="#FF1A1A1A"/>
            <TextBlock x:Name="PinDesc"
                       Margin="0,4,0,0"
                       Text="Keep the Tray Media icon visible in the notification area instead of Hidden icons."
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="#FF5D5D5D"/>
          </StackPanel>
          <ToggleButton x:Name="PinToTrayToggle"
                        Grid.Column="1"
                        Style="{StaticResource WinToggle}"
                        VerticalAlignment="Center"
                        Checked="OnPinChanged"
                        Unchecked="OnPinChanged"/>
        </Grid>

        <TextBlock x:Name="HintText"
                   Margin="0,4,0,0"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Foreground="#FF5D5D5D"
                   Text="If the icon is still hidden, open Settings → Personalization → Taskbar → Select which icons appear on the taskbar."/>

        <TextBlock x:Name="LegalText"
                   Margin="0,28,0,0"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Foreground="#FF5D5D5D"
                   Text="Tray Media 1.0.0-beta.1  ·  © 2026 krmll4444  ·  MIT License"/>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
